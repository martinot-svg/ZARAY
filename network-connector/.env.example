# Exécuter localement sur la machine qui peut joindre le routeur MikroTik.
# Garder ce fichier PRIVÉ après remplacement des valeurs.
ZARAY_URL=https://zaray.vercel.app
ZARAY_ROUTER_ID=identifiant-du-routeur-cree-dans-ZARAY
ZARAY_PAIRING_TOKEN=code-unique-genere-dans-le-module-Gestion-reseau
MIKROTIK_URL=https://adresse-locale-du-routeur
MIKROTIK_USER=utilisateur-routeros-dedie
MIKROTIK_PASSWORD=mot-de-passe-configure-sur-le-routeur
# En présence d'une autorité de certification interne :
# NODE_EXTRA_CA_CERTS=/chemin/vers/autorite-certification.pem
